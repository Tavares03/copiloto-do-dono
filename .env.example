# Copie para .env e ajuste. O .env nunca vai para o git.

# --- Banco de dados (PostgreSQL) -------------------------------------------
# Host e porta vistos da SUA máquina. Dentro do docker-compose a API usa db:5432.
DB_HOST=localhost
# 5433 para não brigar com um Postgres que já esteja usando a 5432
DB_PORT=5433
DB_NAME=copiloto
# Usuário dono do banco: cria o schema e carrega os dados. Só usado no setup.
DB_ADMIN_USER=copiloto
DB_ADMIN_PASSWORD=troque-esta-senha
# Usuário somente leitura usado pelo agente (só enxerga o schema analytics).
DB_RO_USER=copiloto_ro
DB_RO_PASSWORD=troque-esta-senha-tambem
# Tempo máximo de cada consulta do agente, em milissegundos.
SQL_TIMEOUT_MS=5000

# --- Dados sintéticos --------------------------------------------------------
# Seed fixa = mesmos dados em qualquer máquina.
DATA_SEED=42
DATA_START=2026-05-01
DATA_END=2026-10-31
# "Hoje" do sistema. Fixo para que "quanto vendi ontem?" e as evals sejam reproduzíveis.
COPILOTO_TODAY=2026-11-01

# --- LLM: provedores gratuitos, compatíveis com a API da OpenAI ---------------------
# Ordem de prioridade. Provedor sem chave é ignorado; Ollama só entra se estiver rodando.
LLM_PROVIDERS=groq,gemini,ollama

# Groq (plano gratuito, sem cartão): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Modelo com bom tool calling. Liste os da SUA conta com: python -m copiloto.llm --models
# Testados em 11/2026: qwen/qwen3.8-27b (padrão) e openai/gpt-oss-120b.
# Limite gratuito observado: 8 mil tokens/minuto e 1.000 requisições/dia.
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini (plano gratuito do AI Studio, sem cartão): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Testados em 11/2026: gemini-2.5-flash (padrão, ~1s) e gemini-3.5-flash (~4s).
GEMINI_MODEL=gemini-2.5-flash
# "none" desliga o raciocínio interno do 2.5 Flash. Sem isso ele gasta o LLM_MAX_TOKENS
# "pensando" e devolve resposta vazia ou cortada. Deixe vazio para não enviar o parâmetro.
GEMINI_REASONING_EFFORT=none
# Idem para o Groq (vazio = padrão do modelo).
GROQ_REASONING_EFFORT=

# Ollama local (opcional, sem custo e sem limite). Dentro do Docker use http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# --- Resiliência ----------------------------------------------------------------------
# Tempo máximo de cada chamada ao LLM, em segundos.
LLM_TIMEOUT_S=30
# Novas tentativas no MESMO provedor antes de pular para o próximo (429, 5xx, rede).
LLM_MAX_RETRIES=2
# Espera base do backoff exponencial: 1s, 2s, 4s...
LLM_BACKOFF_BASE_S=1.0
# Se o provedor pedir para esperar mais que isso (header Retry-After), pula direto.
LLM_RETRY_AFTER_MAX_S=10
# Circuit breaker: depois de N falhas seguidas, o provedor fica em espera por X segundos.
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_S=300

# --- Agente ---------------------------------------------------------------------------
# Máximo de chamadas ao LLM por pergunta (cada uma pode pedir várias tools).
AGENT_MAX_STEPS=6
# Máximo de linhas que o run_sql devolve.
SQL_ROW_LIMIT=200
# Onde ficam os modelos de previsão treinados (demand_v1_AAAA-MM-DD.joblib).
MODEL_DIR=models
# 0 = respostas mais estáveis (bom para evals).
LLM_TEMPERATURE=0
# Teto de tokens de saída por chamada. Sem ele o Groq gratuito "reserva" ~900 e devolve 429
# (limite de 1.000 tokens de saída por minuto).
LLM_MAX_TOKENS=700

# --- API, interface e webhook ---------------------------------------------------------
LOG_LEVEL=INFO
# Portas na SUA máquina quando sobe com docker compose (troque se já estiverem em uso).
API_PORT=8000
UI_PORT=8501
# Onde a interface Streamlit encontra a API rodando fora do Docker
# (dentro do docker-compose isso já é configurado como http://api:8000).
API_URL=http://localhost:8000
# Tempo máximo que a interface espera uma resposta da API, em segundos.
API_TIMEOUT_S=120
# Segredo que o N8N envia no header X-Webhook-Secret. Vazio = webhook desligado.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(24))"
WEBHOOK_SECRET=
# Telefones autorizados a conversar pelo WhatsApp, separados por vírgula. Vazio = qualquer um.
WEBHOOK_ALLOWED_SENDERS=

# --- Cache em disco das respostas do LLM (economiza cota gratuita nas evals) -----------
LLM_CACHE_ENABLED=false
LLM_CACHE_DIR=.cache/llm
